# Server Configuration
PORT=8080
ENV=development
LOG_LEVEL=info

# Database Configuration
# For local development with docker-compose:
# DB_URL=postgresql://postgres:postgres@postgres:5432/carter?sslmode=disable
# For external database (e.g., Aiven, AWS RDS):
DB_URL=postgresql://user:password@host:port/dbname?sslmode=require

# JWT Configuration
JWT_SECRET=your-secret-key-here

# RabbitMQ Configuration
# For local development with docker-compose:
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
# For external RabbitMQ:
RABBITMQ_URL=amqp://guest:guest@localhost:5672
QUEUE_NAME=carter_queue
EXCHANGE_NAME=scarter.embedding
EXCHANGE_TYPE=direct
ROUTING_KEY=source.process
WORKER_COUNT=5

# DigitalOcean Spaces Configuration
DO_REGION=blr1
DO_ENDPOINT=https://blr1.digitaloceanspaces.com
DO_ACCESS_KEY=DO00XXXXXXXX
DO_SECRET_KEY=XXXXXXXXXXXXXXXX
DO_BUCKET=my-bucket
PRESIGN_EXPIRY=15

# Redis Configuration
# For local development with docker-compose:
# REDIS_ADDR=redis:6379
# For external Redis:
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
